<?xml version="1.0" encoding="utf-8"?>
<!--
    Rutas de archivos para FileProvider
    Permite compartir archivos de la app con otras aplicaciones de forma segura
    (Ejemplo: compartir audio de emergencia con WhatsApp, email, etc.)
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Archivos internos de la app -->
    <files-path
        name="internal_files"
        path="." />

    <!-- Carpeta específica de audios de emergencia -->
    <files-path
        name="emergency_audios"
        path="emergency_audios/" />

    <!-- Caché temporal -->
    <cache-path
        name="cache"
        path="." />

    <!-- Almacenamiento externo (si se usa) -->
    <external-files-path
        name="external_files"
        path="." />

    <!-- Caché externo -->
    <external-cache-path
        name="external_cache"
        path="." />

</paths>