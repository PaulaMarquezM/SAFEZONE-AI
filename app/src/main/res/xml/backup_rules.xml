<?xml version="1.0" encoding="utf-8"?>
<!--
    Reglas de backup para Android 6 a Android 11 (API 23-30)
    Define qué datos se respaldan automáticamente
-->
<full-backup-content>
    <!-- Incluir la base de datos de contactos -->
    <include domain="database" path="safezone_database"/>

    <!-- Incluir preferencias compartidas -->
    <include domain="sharedpref" path="."/>

    <!-- Incluir archivos internos -->
    <include domain="file" path="."/>

    <!-- EXCLUIR archivos de audio de emergencia (privacidad y tamaño) -->
    <exclude domain="file" path="emergency_audios/"/>

    <!-- EXCLUIR caché temporal -->
    <exclude domain="file" path="cache/"/>
</full-backup-content>